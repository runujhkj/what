# what service defaults (copy to .env.service)
WHAT_SERVICE_HOST=127.0.0.1
WHAT_SERVICE_PORT=8765
WHAT_SERVICE_SSE_PATH=/events
WHAT_SERVICE_WS_PATH=/ingest
WHAT_SERVICE_HTTP_PATH=/ingest-http
WHAT_SERVICE_PAIR_PATH=/pair
# WHAT_SERVICE_LOCAL_PAIR=1
WHAT_SERVICE_MDNS_NAME=what
WHAT_SERVICE_MDNS_ENABLED=0
WHAT_SERVICE_MAX_CLIENTS=4

# optional
# WHAT_SERVICE_LANGUAGE=en
# WHAT_SERVICE_DEVICE=cuda
# WHAT_SERVICE_COMPUTE_TYPE=float16
# WHAT_SERVICE_MODEL=medium
# Battery-tuned defaults (beam_size=1, overlap_ms=0, vad_speech_ratio=0.2) live in config/default.toml.
# WHAT_TEST_MAX_WER=0.20
# WHAT_BATTERY_MODELS=small,medium
